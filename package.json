{
  "name": "pdir-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.{ts,mjs,json,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.{ts,mjs,json,yml}\"",
    "start": "ng serve",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "build": "ng build",
    "api:types": "npx --yes openapi-typescript@7.13.0 api/openapi.json -o src/app/core/api/schema.ts && prettier --write src/app/core/api/schema.ts",
    "api:check": "node scripts/check-api-contract.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:smoke": "playwright test -c e2e/playwright.config.ts --grep @smoke",
    "e2e:types": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^22.20.4",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "puppeteer": "^25.3.0",
    "typescript-eslint": "^8.62.0"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "puppeteer": true,
    "esbuild": true,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
